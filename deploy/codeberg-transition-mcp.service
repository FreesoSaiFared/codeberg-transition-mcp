[Unit]
Description=Codeberg Transition MCP (protected local service)
After=network-online.target
[Service]
Type=simple
WorkingDirectory=/mnt/SERVE/10-Projects/codeberg-transition-mcp
EnvironmentFile=-%h/.config/codeberg-transition-mcp/env
ExecStart=/home/linuxbrew/.linuxbrew/bin/node src/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=default.target
